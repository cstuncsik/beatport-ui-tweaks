{
  "name": "beatport-ui-tweaks",
  "version": "2.5.0",
  "type": "module",
  "description": "A web extension that adds some useful feature to beatport.com site",
  "scripts": {
    "build": "parcel build src/manifest.json --config @parcel/config-webextension",
    "postbuild": "node scripts/postbuild.js",
    "dev": "parcel watch src/manifest.json --host localhost --config @parcel/config-webextension",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "playwright test --project default",
    "typecheck": "tsc --noEmit",
    "test:live": "playwright test --project live",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "author": "Csaba Tuncsik <csaba.tuncsik@gmail.com>",
  "repository": "github:cstuncsik/beatport-ui-tweaks",
  "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@parcel/config-webextension": "^2.16.4",
    "@parcel/core": "^2.16.4",
    "@parcel/transformer-sass": "^2.16.4",
    "@playwright/test": "^1.64.0",
    "@types/chrome": "^0.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "archiver": "^8.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "parcel": "^2.16.4",
    "sharp": "^0.33.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "alias": {
    "process": {
      "global": "{}"
    }
  }
}
